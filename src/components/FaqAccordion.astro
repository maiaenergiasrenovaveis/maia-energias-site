---
import type { FaqItem } from "../data/faq";

interface Props {
  items: FaqItem[];
  includeSchema?: boolean;
}
const { items, includeSchema = true } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<div class="divide-y divide-slate-200 border-t border-b border-slate-200">
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer items-center justify-between font-semibold text-maia-navy list-none">
          {item.question}
          <span class="ml-4 shrink-0 text-maia-blue group-open:rotate-45 transition-transform">+</span>
        </summary>
        <p class="mt-3 text-slate-600 leading-relaxed">{item.answer}</p>
      </details>
    ))
  }
</div>

{
  includeSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )
}
