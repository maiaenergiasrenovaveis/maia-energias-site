---
import { Image } from "astro:assets";
import logoIcon from "../assets/logo-icon.png";

const navItems = [
  { href: "/investidores", label: "Investidores" },
  { href: "/empresas", label: "Empresas" },
  { href: "/sobre", label: "Sobre" },
  { href: "/faq", label: "FAQ" },
  { href: "/blog", label: "Blog" },
  { href: "/contato", label: "Contato" },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-white border-b border-slate-100 sticky top-0 z-50">
  <div class="mx-auto max-w-6xl px-4 flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-2.5">
      <Image src={logoIcon} alt="" height={44} densities={[1, 2]} class="h-11 w-auto" />
      <span class="leading-tight">
        <span class="block text-lg font-bold text-maia-navy">MAIA</span>
        <span class="block text-[10px] font-semibold uppercase tracking-wide text-maia-navy/70">Energias Renováveis</span>
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium transition-colors",
              currentPath.startsWith(item.href)
                ? "text-maia-blue-dark"
                : "text-maia-navy hover:text-maia-blue",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="https://wa.me/5511981220711"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center rounded-full bg-maia-orange px-5 py-2.5 text-sm font-semibold text-maia-navy hover:bg-maia-navy hover:text-white transition-colors"
    >
      Falar no WhatsApp
    </a>

    <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
    <label
      for="mobile-menu-toggle"
      class="md:hidden flex h-10 w-10 items-center justify-center rounded-lg text-maia-navy cursor-pointer"
      aria-label="Abrir menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <nav
      id="mobile-menu"
      class="hidden peer-checked:flex md:hidden flex-col absolute top-20 left-0 w-full bg-white border-b border-slate-100 px-4 py-4 gap-1 shadow-lg"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-3 py-2.5 text-base font-medium transition-colors",
              currentPath.startsWith(item.href)
                ? "bg-slate-50 text-maia-blue-dark"
                : "text-maia-navy hover:bg-slate-50",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://wa.me/5511981220711"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center rounded-full bg-maia-orange px-5 py-2.5 text-sm font-semibold text-maia-navy"
      >
        Falar no WhatsApp
      </a>
    </nav>
  </div>
</header>
