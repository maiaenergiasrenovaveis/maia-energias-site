---
import PortalLayout from "../../layouts/PortalLayout.astro";
---

<PortalLayout title="Monitor de Eletropostos" active="monitor">
  <div class="bg-emerald-50 border-b border-emerald-200 text-emerald-800 text-sm text-center py-2 px-4">
    Dados em tempo real — fonte: mapa público de eletropostos da Tupi (api.tupinambaenergia.com.br). Não é uma integração oficial/contratada, apenas dados publicamente expostos no mapa deles.
  </div>

  <div class="bg-white border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div>
        <h1 class="text-lg font-bold text-maia-navy">Maia <span class="text-maia-orange-dark">Eletropostos</span></h1>
        <p class="text-sm text-slate-500">Monitoramento de Funcionamento · Estado de São Paulo</p>
      </div>
      <div class="flex items-center gap-2">
        <span id="last-updated" class="text-xs text-slate-400 whitespace-nowrap">Carregando...</span>
        <button id="refresh-btn" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600">↻ Atualizar</button>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-6">
    <div id="loading-state" class="text-center py-16 text-slate-400">Carregando estações de São Paulo...</div>
    <div id="error-state" class="hidden text-center py-16 text-red-500">Não foi possível carregar os dados agora. Tente atualizar em instantes.</div>

    <div id="content" class="hidden">
      <!-- KPIs -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 mb-2">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Estações em SP</p>
          <p id="kpi-stations" class="mt-1 text-3xl font-bold text-maia-navy"></p>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Conectores monitorados</p>
          <p id="kpi-connectors" class="mt-1 text-3xl font-bold text-maia-navy"></p>
          <p id="kpi-connectors-acdc" class="text-[11px] text-slate-400 mt-1"></p>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Operacionais agora</p>
          <p id="kpi-operational" class="mt-1 text-3xl font-bold text-maia-green"></p>
          <p class="text-[11px] text-slate-400 mt-1">sem falha — inclui ociosos</p>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Em uso agora</p>
          <p id="kpi-in-use" class="mt-1 text-3xl font-bold text-maia-blue"></p>
          <p class="text-[11px] text-slate-400 mt-1">carregando neste momento</p>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Com problema agora</p>
          <p id="kpi-problem" class="mt-1 text-3xl font-bold text-red-600"></p>
        </div>
      </div>
      <p class="text-xs text-slate-400 mb-6">"Operacional" = sem falha detectada (pode estar ocioso/disponível ou carregando). "Em uso" = carregando de verdade neste momento — os dois números são diferentes de propósito.</p>

      <div class="rounded-xl bg-white border border-slate-200 p-4 mb-4 flex items-center justify-between flex-wrap gap-2">
        <div>
          <p class="text-sm font-semibold text-maia-navy">Cobertura de preço: <span id="price-coverage" class="text-maia-orange-dark"></span></p>
          <p class="text-xs text-slate-400 mt-0.5">O preço de cada posto é coletado aos poucos (~20 a cada 5 min) para não sobrecarregar o servidor da Tupi — leva algumas horas para cobrir todo o estado.</p>
        </div>
      </div>

      <div class="rounded-xl bg-white border border-slate-200 p-4 mb-8 flex items-center justify-between flex-wrap gap-2">
        <div>
          <p class="text-sm font-semibold text-maia-navy">Mercado total estimado (fonte: ABVE, jul/2026): <span class="text-maia-orange-dark">6.954 eletropostos em SP</span> <span class="text-slate-400 font-normal">(5.401 AC / 1.553 DC)</span></p>
          <p class="text-xs text-slate-400 mt-0.5">Nossa cobertura (via Tupi): <span id="market-coverage" class="font-semibold text-maia-navy"></span>. Número da ABVE é atualizado manualmente de vez em quando, não é dado ao vivo — <a href="https://abve.org.br/abve-data/bi-eletropostos/" target="_blank" rel="noopener" class="underline">ver painel da ABVE</a>.</p>
        </div>
      </div>

      <!-- Comparativo por região -->
      <section class="mb-8">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-1">Comparativo por Região</h2>
        <p class="text-xs text-slate-400 mb-4 pl-3">Agrupamento aproximado por proximidade — não são limites administrativos oficiais.</p>
        <div id="region-cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6"></div>
      </section>

      <!-- Status breakdown -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Status dos Conectores</h2>
        <div id="status-breakdown" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3"></div>
      </section>

      <!-- Mapa -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3">Mapa de Eletropostos — SP</h2>
            <p id="map-mode-hint" class="text-xs text-slate-400 pl-3">Verde = operacional · Vermelho = com problema · Cinza = sem dado de conector · clique num ponto para detalhes</p>
          </div>
          <button id="heatmap-toggle" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 whitespace-nowrap">🔥 Mapa de calor</button>
        </div>
        <div class="mb-3">
          <input id="search-input" placeholder="🔍 Buscar posto, rede, rua ou estabelecimento..." class="rounded-lg border border-slate-300 px-3 py-2 text-sm w-full" />
          <div class="flex flex-wrap items-center gap-3 mt-2">
            <select id="network-filter" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
              <option value="">Todas as redes</option>
            </select>
            <select id="status-filter" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
              <option value="">Qualquer status</option>
              <option value="ok">Operacional</option>
              <option value="problema">Com problema</option>
            </select>
          </div>
          <p id="search-status" class="text-xs text-slate-400 mt-1"></p>
        </div>
        <div id="map" class="h-[420px] rounded-lg z-0"></div>
      </section>

      <!-- Top 10 -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3">Top 10 Eletropostos — Faturamento Estimado</h2>
          <div id="top10-tabs" class="flex flex-wrap gap-1 bg-slate-100 rounded-lg p-1">
            <button data-window="24h" class="top10-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">24h</button>
            <button data-window="7d" class="top10-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">7 dias</button>
            <button data-window="15d" class="top10-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">15 dias</button>
            <button data-window="30d" class="top10-tab px-3 py-1.5 rounded-md text-xs font-semibold bg-maia-green text-white">30 dias</button>
            <button data-window="all" class="top10-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">Acumulado</button>
          </div>
        </div>
        <p class="text-xs text-slate-400 mb-3">Clique numa estação para ver detalhes. Receita estimada — veja metodologia abaixo.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
                <th class="py-2 pr-2">#</th>
                <th class="py-2 pr-2">Posto</th>
                <th class="py-2 pr-2">Região</th>
                <th class="py-2 pr-2">Potência</th>
                <th class="py-2 pr-2">Uso</th>
                <th class="py-2 pr-2">Preço</th>
                <th class="py-2 pr-2 text-right">Receita estimada</th>
              </tr>
            </thead>
            <tbody id="top10-tbody"></tbody>
          </table>
        </div>
      </section>

      <!-- Rede breakdown -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Por Rede</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
                <th class="py-2 pr-2">Rede</th>
                <th class="py-2 pr-2">Estações</th>
                <th class="py-2 pr-2">Conectores</th>
                <th class="py-2 pr-2 text-right">% Operacional</th>
              </tr>
            </thead>
            <tbody id="networks-tbody"></tbody>
          </table>
        </div>
      </section>

      <!-- Potência instalada -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Potência dos Conectores</h2>
        <canvas id="powerChart" height="90"></canvas>
        <p id="power-chart-note" class="text-xs text-amber-600 mt-2"></p>
      </section>

      <!-- Lista de estações -->
      <section class="mb-8 rounded-xl bg-white border border-slate-200 p-5">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3">Estações</h2>
          <span id="stations-count" class="text-xs text-slate-400"></span>
        </div>
        <p class="text-xs text-slate-400 mb-3">Clique numa linha para ver detalhes.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-200">
                <th class="py-2 pr-2">Posto</th>
                <th class="py-2 pr-2">Rede</th>
                <th class="py-2 pr-2">Região</th>
                <th class="py-2 pr-2">Conectores</th>
                <th class="py-2 pr-2">Status</th>
                <th class="py-2 pr-2">Uso (30d)</th>
                <th class="py-2 pr-2">Preço</th>
                <th class="py-2 pr-2 text-right">Receita est. (30d)</th>
              </tr>
            </thead>
            <tbody id="stations-tbody"></tbody>
          </table>
        </div>
      </section>

      <!-- Metodologia -->
      <section class="rounded-xl bg-slate-100 p-5 text-xs text-slate-500 space-y-1.5">
        <p class="font-semibold text-slate-600 uppercase tracking-wide text-[11px] mb-2">Metodologia & Fontes</p>
        <p><strong>Fonte:</strong> endpoint público usado pelo mapa de eletropostos da Tupi (não documentado oficialmente; encontrado inspecionando o site público deles). Sem chave de API, sem contrato firmado — pode mudar ou parar de funcionar sem aviso.</p>
        <p><strong>ClubeCharger (selo "CC"):</strong> complementa a Tupi com postos cadastrados na plataforma ClubeCharger — só os "vinculados" (com status ao vivo), não a lista aberta de cadastro comunitário deles, que não tem telemetria real.</p>
        <p><strong>GO Electric (selo "GE"):</strong> postos publicados na página deles, sem status ao vivo nem preço — aparecem como "sem dado de conector" até termos como confirmar operação/uso, servindo por enquanto só como referência de localização e potência.</p>
        <p><strong>Filtro geográfico:</strong> estações dentro de uma caixa delimitadora aproximada do estado de SP (pode incluir alguns pontos de fronteira com estados vizinhos). Regiões são agrupadas por proximidade a um ponto de referência, não por limite administrativo real.</p>
        <p><strong>"Sem dado":</strong> nem toda estação listada no mapa da Tupi tem telemetria de conector — cerca de 70% delas aparecem só como ponto no mapa (provavelmente cadastros não conectados ao monitoramento ao vivo deles), sem status/preço/receita possíveis de calcular. A lista de estações prioriza mostrar primeiro as que têm telemetria real.</p>
        <p><strong>Status:</strong> refletem o último estado sincronizado de cada conector (protocolo OCPP): Available, Charging, Preparing, Finishing, Reserved = operacional (sem falha); Faulted, Unavailable, SuspendedEV = com problema.</p>
        <p><strong>Operacional ≠ em uso:</strong> "operacional" inclui tanto Available (disponível, ocioso, sem ninguém carregando) quanto Charging (carregando de verdade). "Em uso" conta só o estado Charging — um posto pode estar 100% operacional (sem nenhuma falha) e 0% em uso.</p>
        <p><strong>Atualização de status:</strong> um job agendado (a cada 5 min) salva um retrato do status de cada conector em um banco próprio, para calcular disponibilidade e uso ao longo do tempo (não só o instante atual). O histórico começou a ser coletado em 30/07/2026 — janelas maiores (7d, 15d, 30d) vão ficando mais precisas com o tempo.</p>
        <p><strong>Preço e receita estimada:</strong> o preço por kWh vem do endpoint de detalhe de cada posto, coletado aos poucos (~20 postos a cada 5 min, cobertura completa em algumas horas) para não sobrecarregar o servidor da Tupi. Receita estimada = horas em uso (Charging) na janela × <strong>40 kWh por hora de uso</strong> (consumo médio realista de recarga — nenhum carro sustenta a potência nominal do carregador por uma hora inteira, a curva de carga cai bastante depois de ~80% de bateria) × preço (R$/kWh). Não usamos a potência nominal cadastrada na fórmula, propositalmente. É uma <strong>estimativa</strong>, não faturamento real auditado (não há dado de sessões/kWh efetivamente vendido nesta fonte).</p>
        <p><strong>Potência com ⚠️:</strong> alguns postos têm potência cadastrada claramente errada na própria Tupi (ex.: vários postos diferentes com exatamente "480kW" em todos os conectores — um valor de placeholder/bug do cadastro deles, não uma leitura real). Sinalizamos com ⚠️ e excluímos esses valores dos totais e do gráfico de potência.</p>
        <p><strong>Janelas maiores (7d/15d/30d/Acumulado) são projeções, não dado acumulado real</strong> enquanto o histórico for curto: pegamos a taxa de uso média já observada e projetamos para o tamanho da janela. Só mostramos % e receita quando há pelo menos 12 leituras (1h) para aquele conector — abaixo disso aparece "coletando…", para não exibir números como "100% de uso" que seriam só ruído de amostra pequena (ex.: 1 leitura que por acaso pegou o carregador em uso).</p>
      </section>
    </div>
  </div>

  <!-- Modal de detalhe -->
  <div id="detail-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50">
    <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="flex items-start justify-between p-5 border-b border-slate-100">
        <div>
          <h3 id="detail-name" class="text-lg font-bold text-maia-navy"></h3>
          <p id="detail-network" class="text-sm text-slate-500"></p>
        </div>
        <button id="detail-close" class="text-slate-400 hover:text-slate-600 text-xl leading-none">✕</button>
      </div>
      <div class="p-5">
        <div id="detail-loading" class="text-center py-10 text-slate-400">Carregando...</div>
        <div id="detail-body" class="hidden">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
            <div class="rounded-lg bg-slate-50 p-3 text-center">
              <p id="detail-connectors" class="text-lg font-bold text-maia-navy"></p>
              <p class="text-[11px] text-slate-500">conectores</p>
            </div>
            <div class="rounded-lg bg-slate-50 p-3 text-center">
              <p id="detail-power" class="text-lg font-bold text-maia-navy"></p>
              <p id="detail-power-note" class="text-[11px] text-slate-500">potência total</p>
            </div>
            <div class="rounded-lg bg-slate-50 p-3 text-center">
              <p id="detail-price" class="text-lg font-bold text-maia-navy"></p>
              <p class="text-[11px] text-slate-500">preço/kWh</p>
            </div>
            <div class="rounded-lg bg-slate-50 p-3 text-center">
              <p id="detail-idle" class="text-lg font-bold text-maia-navy"></p>
              <p class="text-[11px] text-slate-500">taxa destrave/min</p>
            </div>
          </div>

          <div id="detail-tabs" class="flex flex-wrap gap-1 bg-slate-100 rounded-lg p-1 mb-4 w-fit">
            <button data-window="24h" class="detail-tab px-3 py-1.5 rounded-md text-xs font-semibold bg-maia-green text-white">24h</button>
            <button data-window="7d" class="detail-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">7 dias</button>
            <button data-window="15d" class="detail-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">15 dias</button>
            <button data-window="30d" class="detail-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">30 dias</button>
            <button data-window="all" class="detail-tab px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600">Acumulado</button>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
            <div class="rounded-lg border border-slate-200 p-3 text-center">
              <p id="detail-uptime" class="text-lg font-bold text-maia-green"></p>
              <p class="text-[11px] text-slate-500">tempo operacional</p>
            </div>
            <div class="rounded-lg border border-slate-200 p-3 text-center">
              <p id="detail-util" class="text-lg font-bold text-maia-blue"></p>
              <p class="text-[11px] text-slate-500">tempo em uso</p>
            </div>
            <div class="rounded-lg border border-maia-green p-3 text-center bg-emerald-50">
              <p id="detail-revenue" class="text-lg font-bold text-maia-green"></p>
              <p class="text-[11px] text-slate-500">receita estimada</p>
            </div>
          </div>

          <p id="detail-chart-title" class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Carros carregando simultaneamente — últimas 24h</p>
          <canvas id="detail-chart" height="120"></canvas>
        </div>
      </div>
    </div>
  </div>
</PortalLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script is:inline>
  (function () {
    const OPERATIONAL_STATES = new Set(["Available", "Charging", "Preparing", "Finishing", "Reserved"]);
    const PROBLEM_STATES = new Set(["Faulted", "Unavailable", "SuspendedEV"]);
    const IN_USE_STATES = new Set(["Charging"]);
    const brl = (n) => Number(n).toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
    const pct = (n) => (n === null || n === undefined ? "—" : Math.round(n * 100) + "%");

    let allStations = [];
    let allRegions = [];
    let map, markersLayer, heatLayer, geocodeMarker, powerChart, detailChart;
    let geocodeTimer = null;
    let heatModeOn = false;
    let top10Window = "30d";

    function stationStatus(station) {
      const states = station.connectors.map((c) => c.state);
      if (states.length === 0) return "unknown";
      if (states.some((s) => PROBLEM_STATES.has(s))) return "problema";
      if (states.every((s) => OPERATIONAL_STATES.has(s))) return "ok";
      return "unknown";
    }

    function stationUtilPct(s) {
      const vals = s.connectors.map((c) => c.utilizationPctWindow).filter((v) => v !== null && v !== undefined);
      return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
    }

    // Diferencia "sem telemetria" (nunca vai ter dado) de "coletando dados"
    // (tem conector, mas ainda não juntou amostra suficiente para um % confiável).
    function usageLabel(s) {
      if (s.connectors.length === 0) return "—";
      const val = stationUtilPct(s);
      if (val !== null) return pct(val);
      const hasSamples = s.connectors.some((c) => (c.samples || 0) > 0);
      return hasSamples ? "coletando…" : "—";
    }

    function connectorPowerLabel(c) {
      if (c.power === null || c.power === undefined) return "?kW";
      return c.powerSuspicious ? `${c.power}kW ⚠️` : `${c.power}kW`;
    }

    function currentFilters() {
      return {
        search: document.getElementById("search-input").value.toLowerCase(),
        network: document.getElementById("network-filter").value,
        status: document.getElementById("status-filter").value,
      };
    }

    function filteredStations(opts) {
      const f = currentFilters();
      const ignoreSearch = opts && opts.ignoreSearch;
      return allStations.filter((s) => {
        if (!ignoreSearch && f.search && !s.name.toLowerCase().includes(f.search) && !s.network.toLowerCase().includes(f.search)) return false;
        if (f.network && s.network !== f.network) return false;
        if (f.status && stationStatus(s) !== f.status) return false;
        return true;
      });
    }

    function renderKPIs() {
      const totalConnectors = allStations.reduce((acc, s) => acc + s.connectors.length, 0);
      let ok = 0, problem = 0, inUse = 0, ac = 0, dc = 0;
      for (const s of allStations) {
        for (const c of s.connectors) {
          if (OPERATIONAL_STATES.has(c.state)) ok++;
          else if (PROBLEM_STATES.has(c.state)) problem++;
          if (IN_USE_STATES.has(c.state)) inUse++;
          if (c.current === "AC") ac++;
          else if (c.current === "DC") dc++;
        }
      }
      document.getElementById("kpi-stations").textContent = allStations.length.toLocaleString("pt-BR");
      document.getElementById("kpi-connectors").textContent = totalConnectors.toLocaleString("pt-BR");
      document.getElementById("kpi-connectors-acdc").textContent = `AC: ${ac.toLocaleString("pt-BR")} · DC: ${dc.toLocaleString("pt-BR")}`;
      document.getElementById("kpi-operational").textContent = totalConnectors ? Math.round((ok / totalConnectors) * 100) + "%" : "—";
      document.getElementById("kpi-in-use").textContent = inUse.toLocaleString("pt-BR");
      document.getElementById("kpi-problem").textContent = problem.toLocaleString("pt-BR");
    }

    function renderRegionCards() {
      const byRegion = {};
      for (const r of allRegions) byRegion[r.code] = { name: r.name, estacoes: 0, estacoesComTelemetria: 0, conectores: 0, ac: 0, dc: 0, ok: 0, receita: 0 };
      for (const s of allStations) {
        const bucket = byRegion[s.regionCode];
        if (!bucket) continue;
        bucket.estacoes++;
        if (s.connectors.length > 0) bucket.estacoesComTelemetria++;
        for (const c of s.connectors) {
          bucket.conectores++;
          if (c.current === "AC") bucket.ac++;
          else if (c.current === "DC") bucket.dc++;
          if (OPERATIONAL_STATES.has(c.state)) bucket.ok++;
        }
        if (s.estimatedRevenue) bucket.receita += s.estimatedRevenue;
      }
      const wrap = document.getElementById("region-cards");
      wrap.innerHTML = Object.values(byRegion).map((r) => `
        <div class="rounded-xl bg-white border-l-4 border-maia-navy p-4">
          <p class="font-bold text-maia-navy text-sm">${r.name}</p>
          <dl class="mt-3 space-y-1.5 text-xs">
            <div class="flex justify-between"><dt class="text-slate-500">Estações</dt><dd class="font-semibold">${r.estacoes.toLocaleString("pt-BR")}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-400 pl-2">— com telemetria</dt><dd class="text-slate-400">${r.estacoesComTelemetria.toLocaleString("pt-BR")}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Conectores</dt><dd class="font-semibold">${r.conectores.toLocaleString("pt-BR")}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-400 pl-2">— AC / DC</dt><dd class="text-slate-400">${r.ac.toLocaleString("pt-BR")} / ${r.dc.toLocaleString("pt-BR")}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Operacional</dt><dd class="font-semibold">${r.conectores ? Math.round((r.ok / r.conectores) * 100) + "%" : "—"}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Receita est. (30d)</dt><dd class="font-semibold text-maia-green">${r.receita ? brl(r.receita) : "—"}</dd></div>
            <div class="flex justify-between"><dt class="text-slate-400 pl-2">— média/conector</dt><dd class="text-slate-400">${r.receita && r.conectores ? brl(Math.round(r.receita / r.conectores)) : "—"}</dd></div>
          </dl>
        </div>
      `).join("");
    }

    function renderStatusBreakdown() {
      const counts = {};
      for (const s of allStations) {
        for (const c of s.connectors) {
          const label = c.state || "Desconhecido";
          counts[label] = (counts[label] || 0) + 1;
        }
      }
      const order = ["Available", "Charging", "Preparing", "Finishing", "Reserved", "Faulted", "Unavailable", "SuspendedEV"];
      const labels = { Available: "Disponível", Charging: "Carregando", Preparing: "Preparando", Finishing: "Finalizando", Reserved: "Reservado", Faulted: "Com falha", Unavailable: "Indisponível", SuspendedEV: "Suspenso" };
      const el = document.getElementById("status-breakdown");
      el.innerHTML = order.map((state) => {
        const count = counts[state] || 0;
        const isProblem = PROBLEM_STATES.has(state);
        return `<div class="rounded-lg border p-3 text-center ${isProblem ? "border-red-200 bg-red-50" : "border-emerald-200 bg-emerald-50"}">
          <p class="text-xl font-bold ${isProblem ? "text-red-600" : "text-emerald-700"}">${count}</p>
          <p class="text-[11px] text-slate-500 mt-0.5">${labels[state]}</p>
        </div>`;
      }).join("");
    }

    function renderNetworksTable() {
      const byNetwork = {};
      for (const s of allStations) {
        byNetwork[s.network] = byNetwork[s.network] || { estacoes: 0, conectores: 0, ok: 0 };
        byNetwork[s.network].estacoes++;
        for (const c of s.connectors) {
          byNetwork[s.network].conectores++;
          if (OPERATIONAL_STATES.has(c.state)) byNetwork[s.network].ok++;
        }
      }
      const rows = Object.entries(byNetwork).sort((a, b) => b[1].estacoes - a[1].estacoes);
      document.getElementById("networks-tbody").innerHTML = rows.map(([network, d]) => `
        <tr class="border-b border-slate-100 hover:bg-slate-50">
          <td class="py-2 pr-2 font-medium text-maia-navy">${network}</td>
          <td class="py-2 pr-2 text-slate-500">${d.estacoes}</td>
          <td class="py-2 pr-2 text-slate-500">${d.conectores}</td>
          <td class="py-2 pr-2 text-right font-semibold ${d.conectores && d.ok / d.conectores >= 0.8 ? "text-maia-green" : "text-amber-600"}">${d.conectores ? Math.round((d.ok / d.conectores) * 100) + "%" : "—"}</td>
        </tr>
      `).join("");

      const networkSelect = document.getElementById("network-filter");
      const currentValue = networkSelect.value;
      networkSelect.innerHTML = '<option value="">Todas as redes</option>' + rows.map(([n]) => `<option value="${n}">${n}</option>`).join("");
      networkSelect.value = currentValue;
    }

    function renderTop10() {
      const ranked = allStations
        .filter((s) => s.estimatedRevenue)
        .sort((a, b) => b.estimatedRevenue - a.estimatedRevenue)
        .slice(0, 10);
      document.getElementById("top10-tbody").innerHTML = ranked.map((s, i) => {
        const powerLabel = s.connectors.map(connectorPowerLabel).join(", ");
        return `<tr class="border-b border-slate-100 hover:bg-slate-50 cursor-pointer" onclick="window.__openStationDetail('${s.id}')">
          <td class="py-2 pr-2 text-slate-400">${i + 1}</td>
          <td class="py-2 pr-2 font-medium text-maia-navy">${s.network} | ${s.name}</td>
          <td class="py-2 pr-2 text-slate-500">${s.regionName}</td>
          <td class="py-2 pr-2 text-slate-500">${powerLabel}</td>
          <td class="py-2 pr-2 font-semibold text-maia-blue">${usageLabel(s)}</td>
          <td class="py-2 pr-2 text-slate-500">${s.pricePerKwh ? "R$" + s.pricePerKwh.toFixed(2) + "/kWh" : "—"}</td>
          <td class="py-2 pr-2 text-right font-semibold text-maia-green">${brl(s.estimatedRevenue)}</td>
        </tr>`;
      }).join("") || `<tr><td colspan="7" class="py-6 text-center text-slate-400">Ainda sem receita estimada suficiente para este período.</td></tr>`;
    }

    function renderStationsTable() {
      const list = [...filteredStations()].sort((a, b) => {
        const aHasData = a.connectors.length > 0 ? 1 : 0;
        const bHasData = b.connectors.length > 0 ? 1 : 0;
        if (aHasData !== bHasData) return bHasData - aHasData;
        return (b.estimatedRevenue || 0) - (a.estimatedRevenue || 0);
      }).slice(0, 300);
      const withTelemetry = filteredStations().filter((s) => s.connectors.length > 0).length;
      document.getElementById("stations-count").textContent =
        `${filteredStations().length.toLocaleString("pt-BR")} estação(ões)${filteredStations().length > 300 ? " — mostrando 300" : ""} · ${withTelemetry.toLocaleString("pt-BR")} com telemetria ao vivo`;
      document.getElementById("stations-tbody").innerHTML = list.map((s) => {
        const status = stationStatus(s);
        const badge = status === "ok"
          ? '<span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Operacional</span>'
          : status === "problema"
            ? '<span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-red-100 text-red-600">Com problema</span>'
            : '<span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">Sem dado</span>';
        const connectorSummary = s.connectors.length ? s.connectors.map(connectorPowerLabel).join(", ") : "—";
        const priceLabel = s.pricePerKwh ? `R$${s.pricePerKwh.toFixed(2)}/kWh` : "—";
        const revenueLabel = s.estimatedRevenue ? brl(s.estimatedRevenue) : "—";
        const sourceBadges = {
          clubecharger: ' <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-100 text-purple-700 align-middle">CC</span>',
          goelectric: ' <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 align-middle">GE</span>',
        };
        const sourceBadge = sourceBadges[s.source] || "";
        return `<tr class="border-b border-slate-100 hover:bg-slate-50 cursor-pointer" onclick="window.__openStationDetail('${s.id}')">
          <td class="py-2 pr-2 font-medium text-maia-navy">${s.name}${sourceBadge}</td>
          <td class="py-2 pr-2 text-slate-500">${s.network}</td>
          <td class="py-2 pr-2 text-slate-500">${s.regionName}</td>
          <td class="py-2 pr-2 text-slate-500">${connectorSummary}</td>
          <td class="py-2 pr-2">${badge}</td>
          <td class="py-2 pr-2 text-slate-500">${usageLabel(s)}</td>
          <td class="py-2 pr-2 text-slate-500">${priceLabel}</td>
          <td class="py-2 pr-2 text-right font-semibold ${s.estimatedRevenue ? "text-maia-green" : "text-slate-300"}">${revenueLabel}</td>
        </tr>`;
      }).join("") || `<tr><td colspan="8" class="py-6 text-center text-slate-400">Nenhuma estação encontrada.</td></tr>`;
    }

    function renderPowerChart() {
      const buckets = { "≤30 kW": 0, "40 kW": 0, "60 kW": 0, "80-120 kW": 0, "150-360 kW": 0 };
      let excluded = 0;
      for (const s of allStations) {
        for (const c of s.connectors) {
          if (c.powerSuspicious) { excluded++; continue; }
          const p = c.power || 0;
          if (p <= 30) buckets["≤30 kW"]++;
          else if (p <= 45) buckets["40 kW"]++;
          else if (p <= 70) buckets["60 kW"]++;
          else if (p <= 120) buckets["80-120 kW"]++;
          else buckets["150-360 kW"]++;
        }
      }
      const note = document.getElementById("power-chart-note");
      if (note) note.textContent = excluded > 0 ? `${excluded} conector(es) com potência cadastrada implausível (>400kW, provável erro da Tupi) excluído(s) deste gráfico.` : "";
      if (powerChart) powerChart.destroy();
      powerChart = new Chart(document.getElementById("powerChart"), {
        type: "bar",
        data: { labels: Object.keys(buckets), datasets: [{ data: Object.values(buckets), backgroundColor: ["#93c5fd", "#60a5fa", "#1c75bc", "#0b3d62", "#5fa746"] }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } },
      });
    }

    function renderMap(focusOnSearch) {
      const searchVal = document.getElementById("search-input").value.trim();
      const textMatches = filteredStations();
      // Se a busca não bateu com nenhum posto (provável endereço/estabelecimento),
      // mantém todos os postos visíveis no mapa (só respeitando rede/status) em vez de
      // esvaziar o mapa — o objetivo de buscar um endereço é ver o que tem AO REDOR dele.
      const isGeocodeFallback = focusOnSearch && searchVal && textMatches.length === 0;
      const list = isGeocodeFallback ? filteredStations({ ignoreSearch: true }) : textMatches;

      markersLayer.clearLayers();
      const bounds = [];
      let singleMarker = null;
      for (const s of list) {
        const status = stationStatus(s);
        const color = status === "ok" ? "#5fa746" : status === "problema" ? "#ef4444" : "#94a3b8";
        const marker = L.circleMarker([s.lat, s.lng], { radius: 6, color, fillColor: color, fillOpacity: 0.85, weight: 1 })
          .bindPopup(`<strong>${s.name}</strong><br>${s.network}<br>${s.connectors.map((c) => `${connectorPowerLabel(c)} · ${c.state || "?"}`).join("<br>") || "sem dado de conector"}<br><a href="#" onclick="window.__openStationDetail('${s.id}');return false;">Ver detalhes →</a>`)
          .addTo(markersLayer);
        if (!isGeocodeFallback) {
          bounds.push([s.lat, s.lng]);
          if (list.length === 1) singleMarker = marker;
        }
      }

      if (focusOnSearch) {
        if (!searchVal) {
          map.setView([-22.6, -48.0], 7);
        } else if (isGeocodeFallback) {
          // Centralização fica a cargo do tryGeocode() (assíncrono) — não mexe na vista aqui.
        } else if (bounds.length === 1) {
          map.setView(bounds[0], 15);
          if (singleMarker) singleMarker.openPopup();
        } else if (bounds.length > 1) {
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });
        }
      }

      renderHeat(list);
    }

    function renderHeat(list) {
      const points = list.map((s) => [s.lat, s.lng, Math.max(1, s.connectors.length)]);
      if (heatLayer) {
        heatLayer.setLatLngs(points);
      } else {
        heatLayer = L.heatLayer(points, { radius: 22, blur: 18, maxZoom: 12, max: 6 });
      }
    }

    function setHeatMode(on) {
      heatModeOn = on;
      const btn = document.getElementById("heatmap-toggle");
      const hint = document.getElementById("map-mode-hint");
      if (on) {
        map.removeLayer(markersLayer);
        heatLayer.addTo(map);
        btn.textContent = "📍 Ver postos";
        btn.classList.add("bg-maia-orange-dark", "text-white");
        btn.classList.remove("bg-slate-100", "text-slate-600");
        hint.textContent = "Concentração de eletropostos — mais quente = mais postos na região. Clique em \"Ver postos\" para voltar aos pontos.";
      } else {
        if (map.hasLayer(heatLayer)) map.removeLayer(heatLayer);
        markersLayer.addTo(map);
        btn.textContent = "🔥 Mapa de calor";
        btn.classList.remove("bg-maia-orange-dark", "text-white");
        btn.classList.add("bg-slate-100", "text-slate-600");
        hint.textContent = "Verde = operacional · Vermelho = com problema · Cinza = sem dado de conector · clique num ponto para detalhes";
      }
    }

    document.getElementById("heatmap-toggle").addEventListener("click", () => setHeatMode(!heatModeOn));

    function renderAll() {
      renderRegionCards();
      renderStatusBreakdown();
      renderNetworksTable();
      renderTop10();
      renderStationsTable();
      renderPowerChart();
      renderMap();
    }

    function clearGeocodeMarker() {
      if (geocodeMarker) { map.removeLayer(geocodeMarker); geocodeMarker = null; }
      document.getElementById("search-status").textContent = "";
    }

    async function tryGeocode(query) {
      const status = document.getElementById("search-status");
      status.textContent = "Buscando endereço/estabelecimento…";
      try {
        const res = await fetch("/portal/api/geocode?q=" + encodeURIComponent(query));
        const data = await res.json();
        // A busca pode ter mudado enquanto o geocode rodava — ignora resultado desatualizado.
        if (document.getElementById("search-input").value.trim() !== query) return;
        if (!data.results || data.results.length === 0) {
          status.textContent = `Nenhum posto, rua ou estabelecimento encontrado para "${query}".`;
          return;
        }
        const r = data.results[0];
        clearGeocodeMarker();
        geocodeMarker = L.marker([r.lat, r.lng], {
          icon: L.divIcon({ className: "", html: '<div style="font-size:28px;line-height:1">📍</div>', iconSize: [28, 28], iconAnchor: [14, 28] }),
        }).bindPopup(`<strong>${r.label}</strong><br><span style="color:#94a3b8">Resultado de endereço (OpenStreetMap) — pode não ter eletroposto.</span>`).addTo(map);
        map.setView([r.lat, r.lng], 16);
        geocodeMarker.openPopup();
        status.textContent = `📍 ${r.label}`;
      } catch (err) {
        console.error("Erro ao geocodificar:", err);
        status.textContent = "Não foi possível buscar o endereço agora.";
      }
    }

    document.getElementById("search-input").addEventListener("input", () => {
      renderStationsTable();
      renderMap(true);
      clearTimeout(geocodeTimer);
      const query = document.getElementById("search-input").value.trim();
      clearGeocodeMarker();
      if (!query) return;
      const hasStationMatch = filteredStations().length > 0;
      if (hasStationMatch) return;
      geocodeTimer = setTimeout(() => tryGeocode(query), 600);
    });
    ["network-filter", "status-filter"].forEach((id) => {
      document.getElementById(id).addEventListener("input", () => { renderStationsTable(); renderMap(); });
    });
    document.getElementById("refresh-btn").addEventListener("click", () => load());

    document.querySelectorAll(".top10-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        top10Window = btn.dataset.window;
        document.querySelectorAll(".top10-tab").forEach((b) => { b.classList.remove("bg-maia-green", "text-white"); b.classList.add("text-slate-600"); });
        btn.classList.add("bg-maia-green", "text-white");
        btn.classList.remove("text-slate-600");
        loadWindow(top10Window, false);
      });
    });

    async function loadWindow(windowKey, isInitial) {
      try {
        const res = await fetch("/portal/api/eletropostos-sp?window=" + windowKey);
        if (!res.ok) throw new Error("bad response");
        const data = await res.json();
        allStations = data.stations;
        allRegions = data.regions || [];
        document.getElementById("last-updated").textContent = "Atualizado " + new Date(data.updatedAt).toLocaleString("pt-BR");
        document.getElementById("price-coverage").textContent = `${(data.priceCoverage || 0).toLocaleString("pt-BR")} de ${data.count.toLocaleString("pt-BR")} postos`;
        const ABVE_SP_TOTAL = 6954;
        document.getElementById("market-coverage").textContent =
          `${data.count.toLocaleString("pt-BR")} estações (${Math.round((data.count / ABVE_SP_TOTAL) * 100)}%)`;
        if (!map) {
          map = L.map("map").setView([-22.6, -48.0], 7);
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "© OpenStreetMap" }).addTo(map);
          markersLayer = L.layerGroup().addTo(map);
          window.__map = map;
          window.__markersLayer = markersLayer;
        }
        if (isInitial) renderKPIs();
        renderAll();
        if (isInitial) {
          document.getElementById("loading-state").classList.add("hidden");
          document.getElementById("content").classList.remove("hidden");
          setTimeout(() => map.invalidateSize(), 0);
        }
      } catch (err) {
        console.error("Erro ao carregar eletropostos:", err);
        if (isInitial) {
          document.getElementById("loading-state").classList.add("hidden");
          document.getElementById("error-state").classList.remove("hidden");
        }
      }
    }

    function load() {
      document.getElementById("loading-state").classList.remove("hidden");
      document.getElementById("error-state").classList.add("hidden");
      document.getElementById("content").classList.add("hidden");
      loadWindow("30d", true);
    }

    // ---- Modal de detalhe ----
    let detailWindow = "24h";
    let currentDetailId = null;

    async function loadDetail(id) {
      document.getElementById("detail-loading").classList.remove("hidden");
      document.getElementById("detail-body").classList.add("hidden");
      const res = await fetch("/portal/api/eletropostos-sp/estacao?id=" + encodeURIComponent(id));
      if (!res.ok) throw new Error("detail not found");
      const d = await res.json();
      document.getElementById("detail-name").textContent = d.name || "(sem nome)";
      const sourceLabels = { clubecharger: " · via ClubeCharger", goelectric: " · via GO Electric" };
      document.getElementById("detail-network").textContent = d.network + (sourceLabels[d.source] || " · via Tupi");
      document.getElementById("detail-connectors").textContent = d.connectorCount;
      document.getElementById("detail-power").textContent = d.totalPowerKw + " kW" + (d.hasSuspiciousPower ? " ⚠️" : "");
      document.getElementById("detail-power-note").textContent = d.hasSuspiciousPower ? "potência total (exclui conector com valor implausível)" : "potência total";
      document.getElementById("detail-price").textContent = d.pricePerKwh ? "R$" + d.pricePerKwh.toFixed(2) : "—";
      document.getElementById("detail-idle").textContent = d.idleFeeValue ? "R$" + d.idleFeeValue.toFixed(2) : "—";

      renderDetailWindow(d);
      renderDetailChart(d);

      window.__currentDetail = d;
      document.getElementById("detail-loading").classList.add("hidden");
      document.getElementById("detail-body").classList.remove("hidden");
    }

    const MIN_SAMPLES_FOR_ESTIMATE = 12; // mantido em sincronia com worker.js
    const DETAIL_CHART_TITLE = {
      "24h": "Carros carregando simultaneamente — últimas 24h",
      "7d": "Carros carregando simultaneamente (média/hora) — últimos 7 dias",
      "15d": "Carros carregando simultaneamente (média/dia) — últimos 15 dias",
      "30d": "Carros carregando simultaneamente (média/dia) — últimos 30 dias",
      all: "Carros carregando simultaneamente (média/dia) — acumulado",
    };

    function renderDetailWindow(d) {
      const w = d.revenueByWindow[detailWindow];
      const collecting = w && w.samples > 0 && w.samples < MIN_SAMPLES_FOR_ESTIMATE;
      const label = collecting ? `coletando… (${w.samples}/${MIN_SAMPLES_FOR_ESTIMATE} amostras)` : null;
      document.getElementById("detail-uptime").textContent = label || pct(w?.uptimePct);
      document.getElementById("detail-util").textContent = label || pct(w?.utilizationPct);
      document.getElementById("detail-revenue").textContent = label || (w?.revenue ? brl(w.revenue) : "—");
    }

    function renderDetailChart(d) {
      const points = (d.timelineByWindow && d.timelineByWindow[detailWindow]) || [];
      const useDate = detailWindow !== "24h";
      const labels = points.map((p) =>
        useDate
          ? new Date(p.t).toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" }) + (detailWindow === "7d" ? " " + new Date(p.t).toLocaleTimeString("pt-BR", { hour: "2-digit" }) : "")
          : new Date(p.t).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" })
      );
      const values = points.map((p) => p.charging);
      document.getElementById("detail-chart-title").textContent = DETAIL_CHART_TITLE[detailWindow] || DETAIL_CHART_TITLE["24h"];
      if (detailChart) detailChart.destroy();
      detailChart = new Chart(document.getElementById("detail-chart"), {
        type: "line",
        data: { labels, datasets: [{ label: "Carros carregando", data: values, borderColor: "#0b3d62", backgroundColor: "rgba(11,61,98,0.08)", fill: true, stepped: detailWindow === "24h", tension: detailWindow === "24h" ? 0 : 0.25, pointRadius: 0 }] },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } },
      });
    }

    document.querySelectorAll(".detail-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        detailWindow = btn.dataset.window;
        document.querySelectorAll(".detail-tab").forEach((b) => { b.classList.remove("bg-maia-green", "text-white"); b.classList.add("text-slate-600"); });
        btn.classList.add("bg-maia-green", "text-white");
        btn.classList.remove("text-slate-600");
        if (window.__currentDetail) {
          renderDetailWindow(window.__currentDetail);
          renderDetailChart(window.__currentDetail);
        }
      });
    });

    window.__openStationDetail = function (id) {
      currentDetailId = id;
      detailWindow = "24h";
      document.querySelectorAll(".detail-tab").forEach((b) => { b.classList.remove("bg-maia-green", "text-white"); b.classList.add("text-slate-600"); });
      document.querySelector('.detail-tab[data-window="24h"]').classList.add("bg-maia-green", "text-white");
      document.getElementById("detail-modal").classList.remove("hidden");
      loadDetail(id).catch((err) => {
        console.error("Erro ao carregar detalhe:", err);
        document.getElementById("detail-modal").classList.add("hidden");
      });
    };
    document.getElementById("detail-close").addEventListener("click", () => document.getElementById("detail-modal").classList.add("hidden"));
    document.getElementById("detail-modal").addEventListener("click", (e) => {
      if (e.target.id === "detail-modal") document.getElementById("detail-modal").classList.add("hidden");
    });

    load();
  })();
</script>
