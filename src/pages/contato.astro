---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsappCta from "../components/WhatsappCta.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contato"
  description="Fale com a Maia Energias Renováveis por WhatsApp ou e-mail. Escritórios em São Paulo/SP e Natal/RN."
>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-maia-navy text-center">Contato</h1>
    <p class="mt-4 text-center text-slate-600 max-w-xl mx-auto">
      Fale com a gente pelo WhatsApp para uma resposta rápida, ou envie um e-mail.
    </p>

    <div class="mt-8 flex justify-center gap-4">
      <WhatsappCta message="Olá! Vim pelo site e gostaria de mais informações." label="Falar no WhatsApp" />
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center justify-center rounded-full border-2 border-maia-navy px-6 py-3 text-sm font-semibold text-maia-navy hover:bg-maia-navy hover:text-white transition-colors"
      >
        Enviar e-mail
      </a>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2">
      {
        site.addresses.map((addr) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <h2 class="font-bold text-maia-navy">{addr.label}</h2>
            <p class="mt-2 text-sm text-slate-600">
              {addr.street}
              <br />
              {addr.city}/{addr.state} — Brasil
            </p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
