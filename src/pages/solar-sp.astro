---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsappCta from "../components/WhatsappCta.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { solarSpFaq } from "../data/faq";

const audiences = [
  "Comércios (lojas, restaurantes, padarias, mercados)",
  "Condomínios residenciais e comerciais",
  "Residências de alto consumo",
];

const steps = [
  {
    title: "Envio da conta de energia",
    description:
      "Envie a conta de energia mais recente do imóvel em São Paulo — ela já mostra o consumo mensal em kWh, usado para confirmar o enquadramento acima de 10.000 kWh/mês.",
  },
  {
    title: "Análise técnica do local",
    description:
      "A Maia avalia a área disponível (telhado ou terreno), exposição solar e a estrutura elétrica do imóvel para dimensionar o sistema.",
  },
  {
    title: "Proposta com os dois modelos",
    description:
      "Apresentação de uma proposta técnica e financeira comparando instalação própria (à vista ou financiada) e o modelo Energy as a Service (EaaS), para o cliente escolher o que faz mais sentido.",
  },
  {
    title: "Instalação e homologação",
    description:
      "Execução da instalação e homologação do sistema junto à distribuidora local (Enel São Paulo), seguindo as regras de geração distribuída da ANEEL.",
  },
  {
    title: "Operação e monitoramento",
    description:
      "Acompanhamento do desempenho do sistema ao longo do tempo, com suporte técnico contínuo.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Instalação de energia solar residencial e comercial",
  provider: { "@type": "Organization", name: "Maia Energias Renováveis" },
  areaServed: { "@type": "City", name: "São Paulo" },
  audience: {
    "@type": "Audience",
    audienceType: "Comércios, condomínios e residências em São Paulo com consumo acima de 10.000 kWh/mês",
  },
};
---

<BaseLayout
  title="Energia Solar em São Paulo | Instalação para Comércios, Condomínios e Residências"
  description="Instalação de energia solar em São Paulo (capital) para comércios, condomínios e residências com consumo acima de 10.000 kWh por mês. Compra própria ou Energy as a Service (EaaS)."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />
  <meta name="geo.placename" content="São Paulo" slot="head" />
  <meta name="geo.region" content="BR-SP" slot="head" />

  <section class="bg-maia-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <span class="text-sm font-semibold uppercase tracking-wide text-maia-orange">Energia Solar em São Paulo</span>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold max-w-2xl">
        Instalação de energia solar para quem consome muito na cidade de São Paulo
      </h1>
      <p class="mt-4 text-white/80 max-w-2xl leading-relaxed">
        Para comércios, condomínios e residências na capital paulista com consumo acima de
        10.000 kWh por mês — instalação própria ou sem aporte de capital, com projeto,
        instalação e homologação feitos pela Maia.
      </p>
      <div class="mt-8">
        <WhatsappCta
          message="Olá! Quero saber mais sobre instalação de energia solar em São Paulo."
          label="Solicitar análise técnica"
        />
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="rounded-2xl border border-maia-blue/30 bg-white p-8 grid gap-6 sm:grid-cols-2">
        <div>
          <span class="text-sm font-semibold uppercase tracking-wide text-maia-blue-dark">Região atendida</span>
          <p class="mt-2 text-maia-navy font-medium">Cidade de São Paulo (capital)</p>
        </div>
        <div>
          <span class="text-sm font-semibold uppercase tracking-wide text-maia-blue-dark">Consumo mínimo</span>
          <p class="mt-2 text-maia-navy font-medium">A partir de 10.000 kWh por mês</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Para quem é</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        audiences.map((item) => (
          <li class="rounded-xl border border-slate-200 p-6 text-center text-slate-600 font-medium">
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy">Duas formas de ter energia solar</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-maia-navy">Instalação própria</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">
            O cliente investe no sistema solar — à vista ou financiado — e o sistema fica
            registrado em seu nome. A Maia projeta, instala e pode dar suporte contínuo de
            operação e manutenção.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-maia-navy">Energy as a Service (EaaS)</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Sem aporte de capital: a Maia projeta, instala e opera o sistema, e o cliente paga
            apenas pela energia efetivamente consumida, geralmente com valor menor que a tarifa
            da distribuidora.
          </p>
        </div>
      </div>
      <p class="mt-4 text-sm text-slate-500">
        A Maia apresenta os dois modelos na proposta técnica e financeira, para o cliente
        escolher o que melhor se encaixa no seu perfil.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Como funciona</h2>
    <ol class="mt-8 space-y-6">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-maia-orange text-sm font-bold text-maia-navy">
              {i + 1}
            </span>
            <div>
              <h3 class="font-bold text-maia-navy">{step.title}</h3>
              <p class="mt-1 text-slate-600 leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="faq" class="bg-slate-50 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy text-center mb-8">
        Perguntas frequentes sobre energia solar em São Paulo
      </h2>
      <FaqAccordion items={solarSpFaq} includeSchema={true} />
    </div>
  </section>

  <section class="bg-maia-orange">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h2 class="text-2xl font-bold text-white">Descubra se o seu consumo se qualifica</h2>
      <div class="mt-6">
        <WhatsappCta
          message="Olá! Quero enviar minha conta de energia para saber se me qualifico para energia solar em São Paulo."
          label="Enviar conta de energia"
          variant="outline"
        />
      </div>
    </div>
  </section>
</BaseLayout>
