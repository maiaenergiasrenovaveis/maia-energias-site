---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsappCta from "../components/WhatsappCta.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import InstagramEmbed from "../components/InstagramEmbed.astro";
import { Image } from "astro:assets";
import bessIllustration from "../assets/illustrations/bess.svg";
import subestacaoIllustration from "../assets/illustrations/subestacao.svg";
import { businessFaq } from "../data/faq";

const audiences = [
  "Indústrias",
  "Empresas comerciais multiunidade",
  "Centros logísticos",
  "Saneamento",
  "Hospitais",
  "Hotéis",
  "Varejo",
  "Agroindústrias",
  "Telecomunicações",
  "Empresas com conta de energia superior a R$50 mil por mês",
];

const problems = [
  "Demanda contratada inadequada",
  "Consumo elevado no horário de ponta",
  "Fator de potência inadequado",
  "Perdas e desperdícios",
  "Equipamentos ineficientes",
  "Qualidade de energia",
  "Contratos inadequados",
  "Oportunidade de migração ao mercado livre",
  "Necessidade de BESS, solar ou backup",
  "Infraestrutura elétrica subdimensionada",
  "Dados de energia inexistentes ou não organizados",
];

const solutions = [
  "Revisão da demanda contratada",
  "Adequação tarifária",
  "Correção do fator de potência (bancos de capacitores)",
  "Usinas solares",
  "Sistemas de armazenamento de energia (BESS)",
  "Modernização de subestações",
  "Automação e monitoramento",
  "Gestão de cargas",
];

const deliverables = [
  "Diagnóstico da conta e da operação",
  "Análise de faturas e curvas de carga",
  "Lista priorizada de oportunidades",
  "Cenários de CAPEX e OPEX",
  "Estimativa de economia e incerteza",
  "Avaliação de BESS, solar, subestação e mercado livre",
  "Plano de implementação",
  "Plano de medição e verificação",
  "Recomendação de avançar, modificar ou não investir",
];

const offerStages = [
  {
    title: "Diagnóstico pago",
    description:
      "Escopo fechado, prazo, dados exigidos, entregáveis e decisão go/no-go definidos antes de começar.",
  },
  {
    title: "Engenharia e implementação",
    description:
      "Honorários, equipamentos, subcontratados, obras, comissionamento e gestão apresentados separadamente.",
  },
  {
    title: "Gestão contínua",
    description:
      "Monitoramento, medição e verificação (M&V), gestão de demanda, acompanhamento do mercado livre, O&M e revisão periódica.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Eficiência energética para empresas",
  provider: { "@type": "Organization", name: "Maia Energias Renováveis" },
  areaServed: "BR",
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Empresas com contas de energia elétrica acima de R$50 mil por mês",
  },
};
---

<BaseLayout
  title="Eficiência Energética para Empresas | Diagnóstico, Engenharia e Gestão Contínua"
  description="Reduza o custo energético da sua empresa com engenharia e dados: diagnóstico técnico, demanda contratada, fator de potência, BESS, solar, mercado livre e gestão contínua de energia."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />
  <section class="bg-maia-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <span class="text-sm font-semibold uppercase tracking-wide text-maia-blue">Empresas</span>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold max-w-2xl">
        Reduza o custo energético da sua empresa com engenharia e dados
      </h1>
      <p class="mt-4 text-white/80 max-w-2xl leading-relaxed">
        A Maia analisa a conta, o perfil de carga e a infraestrutura elétrica da empresa antes de
        recomendar qualquer investimento — eficiência, demanda, fator de potência, mercado livre,
        BESS, solar ou subestação, conforme o que o diagnóstico apontar como prioridade.
      </p>
      <div class="mt-8">
        <WhatsappCta message="Olá! Quero solicitar uma análise inicial para minha empresa." label="Solicitar uma análise inicial" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Para quem é</h2>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {
        audiences.map((item) => (
          <li class="rounded-full border border-slate-200 px-5 py-2.5 text-sm font-medium text-slate-600">
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-maia-navy">Problemas analisados</h2>
        <ul class="mt-6 space-y-3">
          {
            problems.map((item) => (
              <li class="flex items-start gap-3 text-slate-600">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-maia-orange" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-maia-navy">Soluções avaliadas</h2>
        <ul class="mt-6 space-y-3">
          {
            solutions.map((item) => (
              <li class="flex items-start gap-3 text-slate-600">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-maia-blue" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Entregáveis</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        deliverables.map((item) => (
          <li class="rounded-xl border border-slate-200 p-5 text-slate-600">{item}</li>
        ))
      }
    </ul>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy text-center">Como a oferta é estruturada</h2>
      <p class="mt-3 text-center text-slate-600 max-w-2xl mx-auto">
        Honorários, equipamentos, obras e gestão são sempre apresentados separadamente — sem
        misturar diagnóstico, implementação e operação em um único valor.
      </p>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          offerStages.map((stage, i) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-maia-orange text-sm font-bold text-maia-navy">
                {i + 1}
              </span>
              <h3 class="mt-4 font-bold text-maia-navy">{stage.title}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{stage.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy">O que é Energy as a Service (EaaS)?</h2>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Energy as a Service (EaaS), ou <strong>energia como serviço</strong>, é um modelo em que a
        empresa contrata soluções de energia — geração solar, armazenamento (BESS), eficiência
        tarifária — sem precisar investir capital próprio na estrutura. A Maia projeta, implementa
        e opera o sistema, e a empresa paga pelo serviço ou pela energia efetivamente utilizada,
        normalmente com redução no valor total da conta desde os primeiros ciclos. Na prática, é
        energia solar sem investimento inicial para a empresa.
      </p>

      <h3 class="mt-8 text-xl font-bold text-maia-navy">Como funciona o modelo EaaS de energia solar?</h3>
      <p class="mt-3 text-slate-600 leading-relaxed">
        O processo começa com um diagnóstico energético (análise da conta de energia mais recente —
        que já traz o histórico de consumo dos últimos 12 meses — e da estrutura elétrica da empresa).
        A partir daí, a Maia estrutura a solução — geração
        distribuída, correção de fator de potência, armazenamento — dimensiona o investimento
        necessário e apresenta um modelo contratual em que a empresa não precisa aportar capital
        próprio para viabilizar o projeto.
      </p>

      <h3 class="mt-8 text-xl font-bold text-maia-navy">Quanto uma empresa pode economizar com energia solar?</h3>
      <p class="mt-3 text-slate-600 leading-relaxed">
        A economia depende do perfil de consumo, da tarifa, da demanda contratada e das condições
        da instalação de cada empresa — por isso é calculada individualmente após o diagnóstico
        energético. A Maia não trabalha com percentuais fixos ou garantidos de economia; os números
        apresentados em cada proposta refletem o cenário específico do cliente.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid gap-8 sm:grid-cols-2">
    <figure class="rounded-xl overflow-hidden border border-slate-200">
      <Image src={bessIllustration} alt="Sistema de armazenamento de energia (BESS)" width={400} height={300} class="w-full h-auto" />
      <figcaption class="px-4 py-3 text-sm font-medium text-maia-navy bg-slate-50">Armazenamento de energia (BESS)</figcaption>
    </figure>
    <figure class="rounded-xl overflow-hidden border border-slate-200">
      <Image src={subestacaoIllustration} alt="Subestação de alta tensão" width={400} height={300} class="w-full h-auto" />
      <figcaption class="px-4 py-3 text-sm font-medium text-maia-navy bg-slate-50">Modernização de subestações</figcaption>
    </figure>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-2xl font-bold text-maia-navy">Cada empresa tem um perfil de consumo diferente</h2>
      <p class="mt-4 max-w-2xl mx-auto text-slate-600 leading-relaxed">
        Dependendo do perfil de consumo, da tarifa, da demanda contratada e das condições da
        instalação, a combinação de medidas pode gerar economias expressivas — calculadas
        individualmente após o diagnóstico energético. Não trabalhamos com promessas de economia
        garantida: cada resultado depende da operação e das características específicas de cada cliente.
      </p>
      <div class="mt-8">
        <WhatsappCta
          message="Olá! Quero enviar minha última conta de energia para uma análise preliminar."
          label="Enviar conta de energia para análise"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Como funciona na prática</h2>
    <div class="mt-8 flex justify-center">
      <InstagramEmbed url="https://www.instagram.com/p/DbGXMycy2Ww/" />
    </div>
    <script async src="https://www.instagram.com/embed.js"></script>
  </section>

  <section id="faq" class="mx-auto max-w-6xl px-4 py-16 scroll-mt-24">
    <h2 class="text-2xl font-bold text-maia-navy text-center mb-8">Perguntas frequentes</h2>
    <FaqAccordion items={businessFaq} includeSchema={true} />
  </section>
</BaseLayout>
