---
import InternoLayout from "../../layouts/InternoLayout.astro";
---

<InternoLayout title="Simulador de Eficiência Energética">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-maia-orange-dark">Eficiência Energética</p>
      <h1 class="text-2xl font-bold text-maia-navy">Simulador de Dimensionamento — Solar e BESS</h1>
      <p class="text-sm text-slate-500 mt-1">Dimensionamento técnico, viabilidade financeira e proposta comercial para clientes Grupo A e Grupo B.</p>
    </div>

    <!-- Etapa 0: seleção do grupo tarifário -->
    <div id="grupo-selector" class="grid sm:grid-cols-2 gap-4 mb-8">
      <button type="button" data-grupo="B" class="grupo-btn text-left rounded-2xl bg-white border-2 border-slate-200 p-6 hover:border-maia-blue transition-colors">
        <p class="text-xs font-bold uppercase tracking-wide text-maia-blue-dark">Grupo B</p>
        <h2 class="mt-1 font-bold text-maia-navy text-lg">Baixa tensão — Dimensionamento Solar</h2>
        <p class="mt-2 text-sm text-slate-500">Residencial, comercial e condomínios. Tarifa por kWh (TE+TUSD), sem demanda contratada. Calcula potência do sistema, geração, CAPEX e payback com a Lei 14.300.</p>
      </button>
      <button type="button" data-grupo="A" class="grupo-btn text-left rounded-2xl bg-white border-2 border-slate-200 p-6 hover:border-maia-blue transition-colors">
        <p class="text-xs font-bold uppercase tracking-wide text-maia-blue-dark">Grupo A</p>
        <h2 class="mt-1 font-bold text-maia-navy text-lg">Alta tensão — Eficiência + BESS</h2>
        <p class="mt-2 text-sm text-slate-500">Indústrias e grandes comércios com demanda contratada. Dimensiona banco de baterias (peak shaving), compara cenários com Mercado Livre e calcula payback / EaaS.</p>
      </button>
    </div>

    <!-- Simulações salvas -->
    <div id="simulacoes-salvas-wrap" class="mb-8">
      <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-3">Simulações salvas</h2>
      <div id="simulacoes-salvas-lista" class="rounded-xl bg-white border border-slate-200 divide-y divide-slate-100 text-sm">
        <p class="p-4 text-slate-400">Carregando...</p>
      </div>
    </div>

    <!-- ============ GRUPO B: SOLAR ============ -->
    <div id="painel-solar" class="hidden">
      <button type="button" class="voltar-btn text-xs font-semibold text-maia-blue-dark mb-4">← Trocar grupo tarifário</button>

      <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Cliente</h2>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-slate-500 mb-1">Nome do cliente</label>
              <input id="s-cliente" type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="Nome" />
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-slate-500 mb-1">Cidade</label>
              <input id="s-cidade" list="lista-cidades" type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2" placeholder="Digite para buscar..." />
              <datalist id="lista-cidades"></datalist>
              <p id="s-cidade-info" class="text-[11px] text-slate-400 mt-1"></p>
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-semibold text-slate-500 mb-1">Tipo de rede</label>
              <select id="s-rede" class="w-full rounded-lg border border-slate-300 px-3 py-2">
                <option value="Monofásica">Monofásica (mín. 30 kWh)</option>
                <option value="Bifásica">Bifásica (mín. 50 kWh)</option>
                <option value="Trifásica" selected>Trifásica (mín. 100 kWh)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Consumo mensal (kWh) — últimos 12 meses</h2>
          <div class="flex items-center gap-2 mb-2">
            <input id="s-consumo-media" type="number" placeholder="Preencher os 12 com um valor médio" class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" />
            <button type="button" id="s-consumo-aplicar" class="text-xs font-semibold text-maia-blue-dark whitespace-nowrap">Aplicar a todos</button>
          </div>
          <div id="s-consumo-grid" class="grid grid-cols-4 gap-1.5 text-xs"></div>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Irradiação e perdas</h2>
          <p class="text-[11px] text-slate-400 mb-2">Índice de sol pleno (kWh/m².dia) por mês. Consulte <a href="https://globalsolaratlas.info" target="_blank" class="underline">globalsolaratlas.info</a> ou CRESESB.</p>
          <div id="s-irradiacao-grid" class="grid grid-cols-4 gap-1.5 text-xs mb-3"></div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Perdas do sistema (%)</label>
              <input id="s-perdas" type="number" value="23" step="0.5" class="w-full rounded-lg border border-slate-300 px-3 py-2" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Perdas orientação/sombra (%)</label>
              <input id="s-perdas-adicionais" type="number" value="0" step="0.5" class="w-full rounded-lg border border-slate-300 px-3 py-2" />
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Potência do sistema</h2>
          <dl class="grid grid-cols-2 gap-2 text-xs bg-slate-50 rounded-lg p-3 mb-3">
            <div class="flex justify-between col-span-2"><dt class="text-slate-500">Potência sugerida</dt><dd id="s-out-potencia-sugerida" class="font-semibold">—</dd></div>
          </dl>
          <label class="block text-xs font-semibold text-slate-500 mb-1">Potência escolhida para o projeto (kWp)</label>
          <input id="s-potencia-escolhida" type="number" step="0.1" class="w-full rounded-lg border border-slate-300 px-3 py-2 mb-3" placeholder="Deixe em branco para usar a sugerida" />
          <label class="block text-xs font-semibold text-slate-500 mb-1">% de simultaneidade</label>
          <input id="s-simultaneidade" type="range" min="0.2" max="0.9" step="0.01" value="0.6" class="w-full accent-maia-orange" />
          <p class="text-[11px] text-slate-400 mt-1"><span id="s-simultaneidade-out">60%</span> — ~30-40% residencial, 50-80% comercial</p>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Tarifas</h2>
          <div class="space-y-2 text-sm">
            <div class="grid grid-cols-2 gap-2">
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">TE sem imp. (R$/kWh)</label><input id="s-te-sem" type="number" step="0.0001" value="0.29274" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">TE com imp. (R$/kWh)</label><input id="s-te-com" type="number" step="0.0001" value="0.37327" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">TUSD sem imp. (R$/kWh)</label><input id="s-tusd-sem" type="number" step="0.0001" value="0.48236" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">TUSD com imp. (R$/kWh)</label><input id="s-tusd-com" type="number" step="0.0001" value="0.5514" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Fio B (R$/kWh)</label><input id="s-fiob" type="number" step="0.0001" value="0.36102" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Iluminação púb. (R$/mês)</label><input id="s-iluminacao" type="number" step="0.01" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">ICMS (%)</label><input id="s-icms" type="number" step="0.1" value="18" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">PIS/COFINS (%)</label><input id="s-piscofins" type="number" step="0.01" value="4.36" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            </div>
          </div>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">CAPEX</h2>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div class="col-span-2"><label class="block text-[11px] font-semibold text-slate-500 mb-1">Valor do kit (R$)</label><input id="s-kit" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Lucro equip. (%)</label><input id="s-lucro-equip" type="number" step="0.1" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Margem venda (%)</label><input id="s-margem" type="number" step="0.1" value="37" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Instal. AC (R$)</label><input id="s-instal-ac" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Projeto/ART (R$)</label><input id="s-projeto-art" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Instalação (R$)</label><input id="s-instalacao" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Frete (R$)</label><input id="s-frete" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div class="col-span-2"><label class="block text-[11px] font-semibold text-slate-500 mb-1">Outros (R$)</label><input id="s-outros" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div class="col-span-2"><label class="block text-[11px] font-semibold text-slate-500 mb-1">Imposto mão de obra (%)</label><input id="s-imposto-mo" type="number" step="0.1" value="6" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Financeiro</h2>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Ano inicial</label><input id="s-ano-inicial" type="number" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Horizonte (anos)</label><input id="s-horizonte" type="number" value="25" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Inflação energia (%a.a.)</label><input id="s-inflacao" type="number" step="0.1" value="10" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">TMA / desconto (%a.a.)</label><input id="s-tma" type="number" step="0.1" value="10" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
        </div>
      </div>

      <!-- Resultados -->
      <div id="s-result-cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6"></div>

      <div class="rounded-xl bg-white border border-slate-200 p-5 mb-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Geração mensal estimada (kWh)</h2>
        <canvas id="s-chart-geracao" height="80"></canvas>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Conta de energia (mês 1)</h2>
          <dl id="s-conta-mes1" class="space-y-2 text-sm"></dl>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Viabilidade financeira</h2>
          <dl id="s-viabilidade" class="space-y-2 text-sm"></dl>
        </div>
      </div>

      <div class="rounded-xl bg-white border border-slate-200 p-5 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3">Fluxo de caixa acumulado (descontado)</h2>
        </div>
        <canvas id="s-chart-payback" height="80"></canvas>
      </div>

      <div class="rounded-xl bg-white border border-slate-200 p-5 mb-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Dados da proposta</h2>
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Código da proposta</label><input id="s-proposta-codigo" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">A/C (responsável no cliente)</label><input id="s-responsavel-nome" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Cargo</label><input id="s-responsavel-cargo" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">E-mail do cliente</label><input id="s-email" type="email" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Forma de pagamento</label><input id="s-forma-pagamento" type="text" value="40% de sinal, 30% na entrega dos materiais e 30% na entrega técnica" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Prazo de execução (dias úteis)</label><input id="s-prazo-execucao" type="number" value="15" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Validade da proposta (dias)</label><input id="s-validade-proposta" type="number" value="10" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button" id="s-export-pdf" class="rounded-lg bg-maia-orange hover:bg-maia-orange-dark text-white font-semibold px-5 py-2.5 text-sm transition-colors">Exportar proposta em PDF</button>
        <button type="button" id="s-salvar" class="rounded-lg bg-white border border-maia-navy/30 hover:bg-slate-50 text-maia-navy font-semibold px-5 py-2.5 text-sm transition-colors">Salvar simulação</button>
        <span id="s-salvar-status" class="text-xs text-slate-400"></span>
      </div>
    </div>

    <!-- ============ GRUPO A: BESS / EFICIÊNCIA ============ -->
    <div id="painel-bess" class="hidden">
      <button type="button" class="voltar-btn text-xs font-semibold text-maia-blue-dark mb-4">← Trocar grupo tarifário</button>

      <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Cliente</h2>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="col-span-2"><label class="block text-xs font-semibold text-slate-500 mb-1">Nome do cliente</label><input id="b-cliente" type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2" /></div>
          </div>
        </div>
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Consumo e demanda (conta atual)</h2>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Energia ponta (kWh/mês)</label><input id="b-energia-ponta" type="number" value="4000" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Energia fora ponta (kWh/mês)</label><input id="b-energia-fora-ponta" type="number" value="45000" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Demanda contratada (kW)</label><input id="b-demanda" type="number" value="230" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Demanda pós-BESS (kW)</label><input id="b-demanda-pos" type="number" value="100" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6 mb-6">
        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Tarifas</h2>
          <div class="grid grid-cols-2 gap-2 text-sm">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Tarifa ponta (R$/kWh)</label><input id="b-tarifa-ponta" type="number" step="0.0001" value="3.04" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Tarifa fora ponta (R$/kWh)</label><input id="b-tarifa-fora-ponta" type="number" step="0.0001" value="0.62" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Tarifa demanda (R$/kW)</label><input id="b-tarifa-demanda" type="number" step="0.01" value="30.07" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Reativo excedente (R$/mês)</label><input id="b-reativo" type="number" step="0.01" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Iluminação púb. (R$/mês)</label><input id="b-iluminacao" type="number" step="0.01" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Outros (R$/mês)</label><input id="b-outros" type="number" step="0.01" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
          <label class="flex items-center gap-2 mt-3 text-sm">
            <input id="b-usar-ml" type="checkbox" class="h-4 w-4" />
            <span class="font-semibold text-slate-600">Considerar migração para Mercado Livre</span>
          </label>
          <div id="b-ml-fields" class="mt-2 hidden">
            <label class="block text-[11px] font-semibold text-slate-500 mb-1">Tarifa Mercado Livre (R$/kWh)</label>
            <input id="b-tarifa-ml" type="number" step="0.0001" value="0.25" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" />
          </div>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Dimensionamento BESS</h2>
          <div class="grid grid-cols-2 gap-2 text-sm mb-3">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Dias úteis/mês</label><input id="b-dias-uteis" type="number" value="21" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Janela de ponta (h)</label><input id="b-horas-ponta" type="number" step="0.5" value="3" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Margem potência (%)</label><input id="b-margem-potencia" type="number" value="20" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Round-trip eff. (%)</label><input id="b-rte" type="number" value="90" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">DoD (%)</label><input id="b-dod" type="number" value="90" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Margem capacidade (%)</label><input id="b-margem-capacidade" type="number" value="15" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
          <dl id="b-dimensionamento-out" class="grid grid-cols-2 gap-2 text-xs bg-slate-50 rounded-lg p-3"></dl>
        </div>

        <div class="rounded-xl bg-white border border-slate-200 p-5">
          <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Aquisição e financeiro</h2>
          <label class="block text-[11px] font-semibold text-slate-500 mb-1">Modo de aquisição</label>
          <select id="b-modo-aquisicao" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm mb-3">
            <option value="capex">Compra (CAPEX)</option>
            <option value="eaas">Assinatura (EaaS / sem CAPEX)</option>
          </select>
          <div id="b-capex-fields" class="grid grid-cols-1 gap-2 text-sm">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Investimento BESS (R$)</label><input id="b-investimento" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
          <div id="b-eaas-fields" class="grid grid-cols-1 gap-2 text-sm hidden">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Mensalidade inicial (R$)</label><input id="b-mensalidade" type="number" value="0" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <label class="flex items-center gap-2 mt-1 text-sm">
              <input id="b-lucro-real" type="checkbox" class="h-4 w-4" />
              <span class="font-semibold text-slate-600">Cliente no regime Lucro Real (créditos tributários sobre a mensalidade)</span>
            </label>
            <div id="b-lucro-real-fields" class="grid grid-cols-2 gap-2 hidden">
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Crédito PIS/COFINS (%)</label><input id="b-credito-piscofins" type="number" step="0.01" value="9.25" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
              <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Crédito IRPJ+CSLL (%)</label><input id="b-credito-irpjcsll" type="number" step="0.1" value="34" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-sm mt-3">
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Horizonte (anos)</label><input id="b-horizonte" type="number" value="10" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Reajuste tarifário (%a.a.)</label><input id="b-reajuste" type="number" step="0.1" value="12.5" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
            <div class="col-span-2"><label class="block text-[11px] font-semibold text-slate-500 mb-1">IPCA — reajuste EaaS (%a.a.)</label><input id="b-ipca" type="number" step="0.01" value="5.14" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          </div>
        </div>
      </div>

      <div id="b-result-cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6"></div>

      <div class="rounded-xl bg-white border border-slate-200 p-5 mb-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Conta mensal — Atual vs. Com BESS</h2>
        <canvas id="b-chart-conta" height="80"></canvas>
      </div>

      <div class="rounded-xl bg-white border border-slate-200 p-5 mb-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-maia-navy border-l-4 border-maia-green pl-3 mb-4">Dados da proposta</h2>
        <div class="grid sm:grid-cols-3 gap-3 text-sm">
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Código da proposta</label><input id="b-proposta-codigo" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">A/C (responsável no cliente)</label><input id="b-responsavel-nome" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Cargo</label><input id="b-responsavel-cargo" type="text" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">E-mail do cliente</label><input id="b-email" type="email" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Forma de pagamento</label><input id="b-forma-pagamento" type="text" value="40% de sinal, 30% na entrega dos materiais e 30% na entrega técnica" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Prazo de execução (dias úteis)</label><input id="b-prazo-execucao" type="number" value="20" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
          <div><label class="block text-[11px] font-semibold text-slate-500 mb-1">Validade da proposta (dias)</label><input id="b-validade-proposta" type="number" value="10" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm" /></div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button" id="b-export-pdf" class="rounded-lg bg-maia-orange hover:bg-maia-orange-dark text-white font-semibold px-5 py-2.5 text-sm transition-colors">Exportar proposta em PDF</button>
        <button type="button" id="b-salvar" class="rounded-lg bg-white border border-maia-navy/30 hover:bg-slate-50 text-maia-navy font-semibold px-5 py-2.5 text-sm transition-colors">Salvar simulação</button>
        <span id="b-salvar-status" class="text-xs text-slate-400"></span>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
  <script src="../../scripts/simuladorEficiencia.js"></script>
</InternoLayout>
