---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  })
    .format(date)
    .toUpperCase();
}
---

<BaseLayout
  title="Blog"
  description="Conteúdo sobre investimento em usinas solares e eficiência energética para empresas."
>
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-4xl px-4 py-16">
      <span class="text-sm font-semibold uppercase tracking-wide text-maia-blue">Blog</span>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold text-maia-navy">
        Conteúdo sobre investimento em energia solar e eficiência energética
      </h1>
      <p class="mt-4 text-slate-600 max-w-2xl leading-relaxed">
        Guias práticos sobre TIR, VPL e payback de usinas solares, créditos de carbono e como
        identificar desperdícios na conta de energia — tudo que você precisa saber antes de
        investir ou contratar um diagnóstico energético.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="divide-y divide-slate-200">
      {
        posts.map((post) => (
          <article class="py-8 first:pt-0">
            <span class="text-xs font-semibold tracking-wide text-slate-400">
              {formatDate(post.data.publishDate)}
            </span>
            <h2 class="mt-2 text-2xl font-bold text-maia-navy">
              <a href={`/blog/${post.id}`} class="hover:text-maia-blue transition-colors">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 text-slate-600 leading-relaxed">{post.data.description}</p>
            <a
              href={`/blog/${post.id}`}
              class="mt-3 inline-block text-sm font-semibold text-maia-blue hover:text-maia-blue-dark"
            >
              Leia mais →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-maia-orange">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center">
      <h2 class="text-2xl font-bold text-white">Fale com a Maia sem compromisso</h2>
      <p class="mt-2 text-white/90">
        Tire dúvidas sobre investimento em usinas solares ou eficiência energética para sua empresa.
      </p>
      <a
        href="https://wa.me/5511981220711"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-maia-navy hover:bg-slate-100 transition-colors"
      >
        Falar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
