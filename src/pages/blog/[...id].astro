---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16 prose prose-slate prose-headings:text-maia-navy prose-a:text-maia-blue">
    <span class="text-xs font-semibold uppercase tracking-wide text-maia-blue not-prose">
      {post.data.audience === "investidores" ? "Investidores" : "Empresas"}
    </span>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
