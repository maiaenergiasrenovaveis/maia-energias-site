---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsappCta from "../components/WhatsappCta.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { eletropostosFaq } from "../data/faq";

const powerOptions = ["60kW", "80kW", "120kW", "160kW", "180kW"];

const audiences = [
  {
    title: "Condomínios",
    description: "Residenciais e comerciais, oferecendo recarga aos moradores, visitantes ou usuários.",
  },
  {
    title: "Comércios e empresas",
    description: "Estacionamentos, shoppings, hotéis e outros negócios que querem atrair e reter clientes.",
  },
  {
    title: "Postos e redes públicas",
    description: "Pontos de recarga rápida de alta potência para uso público, em locais de alto fluxo.",
  },
  {
    title: "Frotas corporativas",
    description: "Empresas com frota própria de veículos elétricos que precisam de infraestrutura dedicada.",
  },
];

const steps = [
  {
    title: "Análise técnica do local",
    description:
      "A Maia avalia a infraestrutura elétrica disponível, a demanda contratada e o perfil de uso esperado para definir a potência e o número de eletropostos adequados.",
  },
  {
    title: "Escolha do modelo",
    description:
      "Compra do equipamento (com instalação e manutenção contratável) ou comodato/EaaS, sem investimento inicial — o cliente escolhe o que faz mais sentido para o seu caso.",
  },
  {
    title: "Instalação",
    description:
      "Execução da instalação elétrica e do eletroposto, incluindo eventuais adequações de infraestrutura necessárias para suportar a potência escolhida.",
  },
  {
    title: "Operação e manutenção",
    description:
      "Acompanhamento contínuo para garantir a disponibilidade do equipamento, com manutenção contratável ao longo do tempo.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Venda e instalação de eletropostos (carregadores para veículos elétricos)",
  provider: { "@type": "Organization", name: "Maia Energias Renováveis" },
  areaServed: "BR",
  audience: {
    "@type": "Audience",
    audienceType: "Condomínios, comércios, postos de combustível e frotas corporativas",
  },
};
---

<BaseLayout
  title="Eletropostos | Venda e Instalação de Carregadores para Veículos Elétricos"
  description="Venda, instalação e manutenção de eletropostos de 60kW a 180kW para condomínios, comércios, postos de combustível e frotas corporativas. Compra ou modelo sem investimento inicial (comodato/EaaS)."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} slot="head" />

  <section class="bg-maia-navy text-white">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <span class="text-sm font-semibold uppercase tracking-wide text-maia-orange">Eletropostos</span>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold max-w-2xl">
        Infraestrutura de recarga para veículos elétricos, do projeto à manutenção
      </h1>
      <p class="mt-4 text-white/80 max-w-2xl leading-relaxed">
        Venda, instalação e manutenção de eletropostos de 60kW a 180kW para condomínios, comércios,
        postos de combustível e frotas corporativas — com compra do equipamento ou modelo sem
        investimento inicial (comodato/EaaS).
      </p>
      <div class="mt-8">
        <WhatsappCta
          message="Olá! Quero saber mais sobre venda e instalação de eletropostos."
          label="Solicitar análise técnica"
        />
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-center text-sm font-semibold uppercase tracking-wide text-maia-blue-dark">
        Potências disponíveis
      </h2>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        {
          powerOptions.map((power) => (
            <span class="rounded-full border-2 border-maia-navy px-6 py-3 text-lg font-bold text-maia-navy bg-white">
              {power}
            </span>
          ))
        }
      </div>
      <p class="mt-6 text-center text-slate-600 max-w-2xl mx-auto">
        A potência ideal é definida conforme o perfil de uso e a infraestrutura elétrica disponível
        no local, avaliados na análise técnica.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Para quem é</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        audiences.map((item) => (
          <li class="rounded-xl border border-slate-200 p-6">
            <h3 class="font-bold text-maia-navy">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy">Duas formas de ter um eletroposto</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-maia-navy">Compra do equipamento</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">
            O cliente adquire o eletroposto e a Maia cuida da instalação — com manutenção
            contratável à parte para garantir a disponibilidade ao longo do tempo.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-bold text-maia-navy">Comodato / EaaS</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Sem investimento inicial: a Maia instala e mantém o equipamento, e o cliente paga
            conforme o uso ou um modelo de serviço combinado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-2xl font-bold text-maia-navy text-center">Como funciona</h2>
    <ol class="mt-8 space-y-6">
      {
        steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-maia-orange text-sm font-bold text-maia-navy">
              {i + 1}
            </span>
            <div>
              <h3 class="font-bold text-maia-navy">{step.title}</h3>
              <p class="mt-1 text-slate-600 leading-relaxed">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="faq" class="bg-slate-50 scroll-mt-24">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-2xl font-bold text-maia-navy text-center mb-8">Perguntas frequentes sobre eletropostos</h2>
      <FaqAccordion items={eletropostosFaq} includeSchema={true} />
    </div>
  </section>

  <section class="bg-maia-orange">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h2 class="text-2xl font-bold text-white">Descubra a potência ideal para o seu local</h2>
      <div class="mt-6">
        <WhatsappCta
          message="Olá! Quero uma análise técnica para instalar eletropostos no meu local."
          label="Solicitar análise técnica"
          variant="outline"
        />
      </div>
    </div>
  </section>
</BaseLayout>
